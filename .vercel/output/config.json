{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/atomic-design-with-react/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/benefits-and-potencial-challenges-on-open-source-projects/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/blockchain-and-react-native-apps/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/my-code-principles/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/react-code-editor/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/sandpack/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/spatial-keyboard-navigation/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/og-image\\.png/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}